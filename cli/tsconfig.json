{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2024", "DOM", "DOM.Iterable"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true, "skipLibCheck": true,
    "noEmit": true, "types": ["node"], "typeRoots": ["./node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
